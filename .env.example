# PocketBase (ORM FastAPI)
POCKETBASE_URL=http://127.0.0.1:8090
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Asistente de voz — Groq (recomendado) o OpenAI
GROQ_API_KEY=
# Alternativa explícita (si no usas GROQ_API_KEY):
# AI_LLM_API_KEY=
# AI_WHISPER_API_KEY=
AI_LLM_BASE_URL=https://api.groq.com/openai/v1
AI_WHISPER_BASE_URL=https://api.groq.com/openai/v1
AI_LLM_MODEL=openai/gpt-oss-120b
# Alternativa rápida en Groq: llama-3.1-8b-instant
AI_LLM_MAX_TOKENS=800
AI_WHISPER_MODEL=whisper-large-v3

# OpenAI directo (opcional: Whisper + GPT + voz TTS)
# OPENAI_API_KEY=
# Voz del asistente (usa OPENAI_API_KEY si AI_TTS_API_KEY está vacío)
# AI_TTS_API_KEY=
# AI_TTS_MODEL=tts-1
# AI_TTS_VOICE=nova
# AI_TTS_PROVIDER=auto
# AI_LLM_BASE_URL=https://api.openai.com/v1
# AI_WHISPER_BASE_URL=https://api.openai.com/v1
# AI_LLM_MODEL=gpt-4o-mini
# AI_WHISPER_MODEL=whisper-1

# Reportes por voz (n8n)
N8N_REPORT_WEBHOOK=
N8N_REPORT_WEBHOOK_SECRET=

# WhatsApp — Evolution API
EVOLUTION_API_URL=https://tu-evolution.ejemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=tu-instancia
